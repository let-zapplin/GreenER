# Backend
NODE_ENV=development
PORT=3000

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=greener
POSTGRES_USER=greener
POSTGRES_PASSWORD=troque_este_valor

# APIs auxiliares
METRICS_API_URL=https://metrics.unilaunch.org
CARBON_API_URL=https://carbon.unilaunch.org
# Opcional: idade máxima dos snapshots em milissegundos; sem valor, fatores ficam indisponíveis para cálculos.
CARBON_INTENSITY_MAX_AGE_MS=1000000

# Autenticacao
JWT_SECRET=troque_este_valor
JWT_EXPIRES_IN=3600 #Obrigatoriamente deve ser um valor numérico, com unidade de segundos

# Monitoramento
# Coleta de métricas de cada serviço (US04)
COLLECTION_INTERVAL_MS=60000
# Sincronização do catálogo de serviços (US02)
SERVICE_SYNC_INTERVAL_MS=300000
EXTERNAL_API_TIMEOUT_MS=10000

# Frontend
CORS_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:3000

# Opcional: imagens de satelite no globo; sem chave, usa cartografia local.
VITE_MAPTILER_API_KEY=
